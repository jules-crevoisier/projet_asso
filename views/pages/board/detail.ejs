<p class="mb-6"><a href="/annonces" class="link shrink-0 whitespace-nowrap text-[15px]">Retour aux annonces</a></p>

<div class="grid gap-x-16 gap-y-12 lg:grid-cols-[2fr_1fr]">
  <div>
    <article class="border-b border-line pb-10">
      <p class="kicker"><%= POST_KINDS[post.kind] || POST_KINDS.other %><% if (post.is_closed) { %> · <span class="text-success">Résolue</span><% } %></p>
      <h1 class="h-page mt-3"><%= post.title %></h1>
      <p class="meta mt-3">Publiée <%= fmt.ago(post.created_at) %> par <%= post.first_name %> <%= post.last_name %>, pour <a class="link-quiet" href="/associations/<%= post.association_slug %>"><%= post.association_name %></a></p>
      <div class="prose-text mt-8 text-[17px]"><%= post.body %></div>
      <% if (canEdit) { %>
        <div class="mt-10 flex flex-wrap gap-2">
          <form method="post" action="/annonces/<%= post.id %>/cloturer"><%- include('../../partials/csrf') %>
            <button class="btn <%= post.is_closed ? 'btn-secondary' : 'btn-primary' %>"><%= post.is_closed ? 'Rouvrir l’annonce' : 'Marquer comme résolue' %></button>
          </form>
          <a href="/annonces/<%= post.id %>/modifier" class="btn btn-secondary">Modifier</a>
          <form method="post" action="/annonces/<%= post.id %>/supprimer" data-confirm="Supprimer cette annonce ?"><%- include('../../partials/csrf') %><button class="btn btn-danger">Supprimer</button></form>
        </div>
      <% } %>
    </article>

    <section id="reponses" aria-labelledby="reponses-titre" class="pt-10">
      <h2 id="reponses-titre" class="h-section mb-1 border-t-2 border-ink pt-3.5 pb-3">Réponses <span class="text-[16px] font-normal text-ink-3"><%= replies.length %></span></h2>
      <% if (replies.length) { %>
        <ol class="rows">
          <% replies.forEach((r) => { %>
            <li class="flex gap-3 py-4">
              <%- include('../../partials/avatar', { first: r.first_name, last: r.last_name }) %>
              <div class="min-w-0 flex-1">
                <p class="flex flex-wrap items-baseline gap-x-2">
                  <strong><%= r.first_name %> <%= r.last_name %></strong>
                  <% if (r.association_name) { %><span class="text-[15px] text-ink-2">pour <%= r.association_name %></span><% } %>
                  <span class="meta"><%= fmt.ago(r.created_at) %></span>
                </p>
                <p class="prose-text mt-1"><%= r.body %></p>
                <% if (r.author_id === user.id || canEdit) { %>
                  <form method="post" action="/annonces/reponses/<%= r.id %>/supprimer" class="mt-1" data-confirm="Supprimer cette réponse ?"><%- include('../../partials/csrf') %><button class="link-quiet text-[14px] text-ink-3">Supprimer</button></form>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ol>
      <% } else { %>
        <p class="py-5 text-ink-2">Pas encore de réponse.</p>
      <% } %>
      <% if (!post.is_closed) { %>
        <form method="post" action="/annonces/<%= post.id %>/repondre" class="mt-2 space-y-4 border-t border-line pt-6">
          <%- include('../../partials/csrf') %>
          <label for="reply" class="label">Répondre</label>
          <textarea id="reply" name="body" rows="4" class="input" required></textarea>
          <% if (myAssociations.length) { %>
            <%- include('../../partials/field', { name: 'association_id', label: 'Signer', type: 'select', options: [['', 'À titre personnel'], ...myAssociations.map((a) => [a.id, `Au nom de ${a.name}`])], cls: 'max-w-sm' }) %>
          <% } %>
          <button class="btn btn-primary">Envoyer la réponse</button>
        </form>
      <% } else { %>
        <p class="notice notice-success mt-4">Cette annonce est résolue : les réponses sont fermées.</p>
      <% } %>
    </section>
  </div>

  <aside>
    <h2 class="h-section mb-0 border-t-2 border-ink pt-3.5 pb-3">Contact</h2>
    <dl class="space-y-3">
      <div><dt class="meta">Association</dt><dd class="flex items-center gap-2"><span class="swatch size-3" style="background-color: <%= post.association_color %>"></span><a class="link-quiet font-semibold" href="/associations/<%= post.association_slug %>"><%= post.association_name %></a></dd></div>
      <% if (post.author_email) { %><div><dt class="meta">E-mail</dt><dd><a class="link break-all" href="mailto:<%= post.author_email %>?subject=<%= encodeURIComponent(post.title) %>"><%= post.author_email %></a></dd></div><% } %>
      <% if (post.association_phone) { %><div><dt class="meta">Téléphone</dt><dd class="tnum"><%= post.association_phone %></dd></div><% } %>
    </dl>
  </aside>
</div>

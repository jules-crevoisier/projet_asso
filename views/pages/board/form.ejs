<%- include('../../partials/page-header', { heading: title, subtitle: post ? `Pour ${post.association_name}.` : 'Visible par toutes les personnes connectées.' }) %>

<form method="post" class="max-w-2xl space-y-10" novalidate>
  <%- include('../../partials/csrf') %>
  <fieldset>
    <legend class="label">Type d'annonce</legend>
    <div class="grid gap-2 sm:grid-cols-2">
      <% Object.entries(POST_KINDS).forEach(([v, label]) => { %>
        <label class="choice items-center py-3"><input type="radio" name="kind" value="<%= v %>" <%= values.kind === v ? 'checked' : '' %>><span class="text-[15px] font-semibold"><%= label %></span></label>
      <% }) %>
    </div>
  </fieldset>
  <% if (!post && associations.length > 1) { %>
    <%- include('../../partials/field', { name: 'association_id', label: 'Au nom de', type: 'select', value: values.association_id, error: errors.association_id, options: associations.map((a) => [a.id, a.name]), cls: 'max-w-md' }) %>
  <% } else if (!post) { %>
    <input type="hidden" name="association_id" value="<%= associations[0].id %>">
  <% } %>
  <%- include('../../partials/field', { name: 'title', label: 'Titre', help: 'Soyez précis : « 10 bénévoles pour la collecte du 15 novembre ».', value: values.title, error: errors.title, required: true, attrs: 'maxlength="200"' }) %>
  <%- include('../../partials/field', { name: 'body', label: 'Détails', help: 'Quoi, quand, où, et comment vous joindre.', type: 'textarea', rows: 8, value: values.body, error: errors.body, required: true }) %>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-8">
    <button class="btn btn-primary"><%= post ? 'Enregistrer les modifications' : 'Publier l’annonce' %></button>
    <a href="<%= post ? `/annonces/${post.id}` : '/annonces' %>" class="link shrink-0 whitespace-nowrap text-[15px]">Annuler</a>
  </div>
</form>

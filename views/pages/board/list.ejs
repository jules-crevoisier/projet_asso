<%- include('../../partials/page-header', {
  heading: 'Annonces',
  subtitle: 'Bénévoles, matériel, salles, partenariats : ce que les associations demandent et proposent.',
  actions: `<a href="/annonces/nouvelle" class="btn btn-primary">Publier une annonce</a>`,
}) %>

<div class="grid gap-x-16 gap-y-8 lg:grid-cols-[14rem_1fr]">
  <aside>
    <form method="get" role="search" class="mb-6">
      <label for="q" class="label">Rechercher</label>
      <div class="flex gap-2">
        <input id="q" type="search" name="q" value="<%= q %>" class="input">
        <% if (kind) { %><input type="hidden" name="type" value="<%= kind %>"><% } %>
        <% if (closed) { %><input type="hidden" name="cloturees" value="1"><% } %>
        <button class="btn btn-secondary btn-icon" aria-label="Lancer la recherche"><%- icon('Search') %></button>
      </div>
    </form>
    <p class="kicker mb-2">Type</p>
    <nav class="-mx-3 flex gap-1 overflow-x-auto lg:flex-col" aria-label="Filtrer par type">
      <a href="/annonces<%= query({ q, cloturees: closed ? '1' : '' }, {}) %>" class="side-link shrink-0 <%= !kind ? 'active' : '' %>">Toutes</a>
      <% Object.entries(POST_KINDS).forEach(([v, label]) => { %>
        <a href="/annonces<%= query({ q, cloturees: closed ? '1' : '' }, { type: v }) %>" class="side-link shrink-0 <%= kind === v ? 'active' : '' %>" <%= kind === v ? 'aria-current=page' : '' %>><%= label %></a>
      <% }) %>
    </nav>
    <p class="mt-6"><a class="link shrink-0 whitespace-nowrap text-[15px]" href="/annonces<%= query({ q, type: kind }, { cloturees: closed ? '' : '1' }) %>"><%= closed ? 'Masquer les annonces résolues' : 'Afficher aussi les annonces résolues' %></a></p>
  </aside>

  <div>
    <% if (posts.length) { %>
      <div class="rows border-y border-line"><% posts.forEach((post) => { %><%- include('../../partials/post-row', { post, excerpt: true }) %><% }) %></div>
    <% } else { %>
      <div class="panel"><%- include('../../partials/empty', { heading: 'Aucune annonce', text: q || kind ? 'Rien ne correspond à ces critères.' : 'Besoin de bras, d’une sono ou d’une salle ? Demandez aux autres associations.', actionHref: '/annonces/nouvelle', actionLabel: 'Publier une annonce' }) %></div>
    <% } %>
  </div>
</div>

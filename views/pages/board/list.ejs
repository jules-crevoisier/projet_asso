<%- include('../../partials/page-header', {
  heading: 'Annonces',
  subtitle: 'Bénévoles, matériel, salles, partenariats : l’entraide entre associations.',
  actions: `<a href="/annonces/nouvelle" class="btn btn-primary">${icon('Plus')}Nouvelle annonce</a>`,
}) %>

<div class="grid gap-6 lg:grid-cols-[220px_1fr]">
  <aside class="space-y-1">
    <a href="/annonces<%= query({ q, cloturees: closed ? '1' : '' }, {}) %>" class="nav-link <%= !kind ? 'active' : '' %>"><%- icon('Inbox', 'size-[18px] text-slate-400') %>Toutes</a>
    <% Object.entries(POST_KINDS).forEach(([v, k]) => { %>
      <a href="/annonces<%= query({ q, cloturees: closed ? '1' : '' }, { type: v }) %>" class="nav-link <%= kind === v ? 'active' : '' %>"><%- icon(k.icon, 'size-[18px] text-slate-400') %><%= k.label %></a>
    <% }) %>
  </aside>

  <div>
    <form method="get" class="mb-4 flex flex-wrap items-center gap-3" data-autosubmit>
      <% if (kind) { %><input type="hidden" name="type" value="<%= kind %>"><% } %>
      <div class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-slate-400"><%- icon('Search') %></span>
        <input type="search" name="q" value="<%= q %>" placeholder="Rechercher une annonce…" class="input pl-9" aria-label="Rechercher">
      </div>
      <label class="chip cursor-pointer has-[:checked]:bg-slate-900 has-[:checked]:text-white has-[:checked]:ring-slate-900">
        <input type="checkbox" name="cloturees" value="1" class="sr-only" <%= closed ? 'checked' : '' %>><%- icon('Archive', 'size-3.5') %>Inclure les résolues
      </label>
    </form>
    <div class="card overflow-hidden">
      <div class="divide-list">
        <% if (posts.length) { posts.forEach((post) => { %><%- include('../../partials/post-row', { post, excerpt: true }) %><% }) } else { %>
          <%- include('../../partials/empty', { iconName: 'Megaphone', heading: 'Aucune annonce', text: 'Soyez la première association à demander ou proposer un coup de main.', actionHref: '/annonces/nouvelle', actionLabel: 'Publier une annonce' }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>

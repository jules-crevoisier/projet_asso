<%- include('../../partials/page-header', {
  heading: title,
  subtitle: event ? `Organisé par ${event.association_name}` : 'Il apparaîtra immédiatement dans le calendrier partagé.',
}) %>

<form method="post" class="grid gap-6 lg:grid-cols-3" data-event-form data-exclude="<%= event ? event.id : '' %>">
  <%- include('../../partials/csrf') %>
  <% if (conflicts.length) { %><input type="hidden" name="confirm" value="1"><% } %>

  <div class="space-y-6 lg:col-span-2">
    <% if (conflicts.length) { %>
      <div class="flex gap-3 rounded-2xl bg-amber-50 p-5 text-sm text-amber-900 ring-1 ring-inset ring-amber-600/20">
        <%- icon('TriangleAlert', 'size-5 text-amber-500') %>
        <div>
          <p class="font-semibold"><%= plural(conflicts.length, 'autre événement') %> sur ce créneau</p>
          <ul class="mt-2 space-y-1">
            <% conflicts.forEach((c) => { %><li class="flex items-center gap-2"><span class="size-2 rounded-full" style="background-color: <%= c.association_color %>"></span><a class="font-medium underline decoration-amber-300 underline-offset-2" href="/evenements/<%= c.id %>" target="_blank"><%= c.title %></a> — <%= c.association_name %>, <%= fmt.short(c.start_at) %>, <%= c.location %></li><% }) %>
          </ul>
          <p class="mt-3">Changez la date, ou confirmez si vos publics ne se recoupent pas.</p>
        </div>
      </div>
    <% } %>

    <section class="card card-pad space-y-5">
      <% if (!event) { %>
        <% if (associations.length > 1) { %>
          <%- include('../../partials/field', { name: 'association_id', label: 'Association organisatrice', type: 'select', value: values.association_id, error: errors.association_id, options: associations.map((a) => [a.id, a.name]) }) %>
        <% } else { %>
          <input type="hidden" name="association_id" value="<%= associations[0].id %>">
          <div class="flex items-center gap-3 rounded-xl bg-slate-50 px-4 py-3 ring-1 ring-slate-900/5">
            <%- include('../../partials/avatar', { first: associations[0].name, color: associations[0].color, size: 'size-8 text-xs rounded-lg' }) %>
            <span class="text-sm">Publié au nom de <strong><%= associations[0].name %></strong></span>
          </div>
        <% } %>
      <% } %>
      <%- include('../../partials/field', { name: 'title', label: 'Titre', value: values.title, error: errors.title, required: true, placeholder: 'Ex. : Fête de quartier du Vouldy', attrs: 'maxlength="200"' }) %>
      <div class="grid gap-5 sm:grid-cols-2">
        <%- include('../../partials/field', { name: 'start', label: 'Début', type: 'datetime-local', value: values.start, error: errors.start, required: true, attrs: 'data-start' }) %>
        <%- include('../../partials/field', { name: 'end', label: 'Fin', type: 'datetime-local', value: values.end, error: errors.end, required: true, attrs: 'data-end' }) %>
      </div>
      <div id="live-conflicts" class="hidden" aria-live="polite"></div>
      <%- include('../../partials/field', { name: 'location', label: 'Lieu', value: values.location, error: errors.location, required: true, placeholder: 'Adresse ou nom du lieu', attrs: 'maxlength="255"' }) %>
      <%- include('../../partials/field', { name: 'description', label: 'Description', type: 'textarea', rows: 6, value: values.description, error: errors.description, required: true, placeholder: 'Programme, public visé, infos pratiques…' }) %>
    </section>

    <section class="card card-pad space-y-5">
      <div><h2 class="card-title">Besoin d'un coup de main ?</h2><p class="mt-1 text-sm text-slate-500">Les autres associations et bénévoles pourront se proposer.</p></div>
      <%- include('../../partials/field', { name: 'volunteers_needed', label: 'Bénévoles recherchés', type: 'number', value: values.volunteers_needed, help: 'Laissez 0 si vous ne cherchez personne.', attrs: 'min="0" max="999"', cls: 'max-w-xs' }) %>
      <%- include('../../partials/field', { name: 'material_needs', label: 'Matériel recherché', type: 'textarea', rows: 3, value: values.material_needs, placeholder: 'Ex. : 2 barnums, 6 tables, une sono' }) %>
    </section>
  </div>

  <div class="space-y-6">
    <section class="card card-pad space-y-5">
      <%- include('../../partials/field', { name: 'category', label: 'Thème', type: 'select', value: values.category, options: Object.entries(CATEGORIES) }) %>
      <fieldset>
        <legend class="label">Visibilité</legend>
        <div class="space-y-2">
          <% [['public', 'Public', 'Visible par tout le monde, même sans compte.', 'Earth'], ['network', 'Réseau', 'Seulement les associations connectées (réunions, préparation…).', 'Lock']].forEach(([v, l, d, ic]) => { %>
            <label class="flex cursor-pointer gap-3 rounded-xl p-3 ring-1 ring-inset ring-slate-200 transition has-[:checked]:bg-brand-50/60 has-[:checked]:ring-2 has-[:checked]:ring-brand-600">
              <input type="radio" name="visibility" value="<%= v %>" class="mt-0.5 accent-brand-600" <%= values.visibility === v ? 'checked' : '' %>>
              <span><span class="flex items-center gap-1.5 text-sm font-medium"><%- icon(ic, 'size-3.5 text-slate-500') %><%= l %></span><span class="mt-0.5 block text-xs text-slate-500"><%= d %></span></span>
            </label>
          <% }) %>
        </div>
      </fieldset>
    </section>
    <div class="card card-pad flex flex-col gap-2">
      <button class="btn <%= conflicts.length ? 'bg-amber-500 text-white hover:bg-amber-600' : 'btn-primary' %> w-full"><%= conflicts.length ? 'Publier quand même' : (event ? 'Enregistrer' : 'Publier l’événement') %></button>
      <a href="<%= event ? `/evenements/${event.id}` : '/evenements' %>" class="btn btn-ghost w-full">Annuler</a>
    </div>
  </div>
</form>

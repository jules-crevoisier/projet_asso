<%- include('../../partials/page-header', {
  heading: title,
  subtitle: event ? `Organisé par ${event.association_name}.` : 'L’événement apparaît dans l’agenda commun dès sa publication.',
}) %>

<form method="post" class="max-w-2xl space-y-12" data-event-form data-exclude="<%= event ? event.id : '' %>" novalidate>
  <%- include('../../partials/csrf') %>
  <% if (conflicts.length) { %>
    <input type="hidden" name="confirm" value="1">
    <div class="notice notice-warn flex-col gap-2" role="alert">
      <p class="font-bold"><%= plural(conflicts.length, 'autre événement') %> sur ce créneau</p>
      <ul class="space-y-1">
        <% conflicts.forEach((c) => { %><li><span class="swatch mr-1.5" style="background-color: <%= c.association_color %>"></span><a class="link-quiet font-semibold" href="/evenements/<%= c.id %>" target="_blank"><%= c.title %></a>, <%= c.association_name %>, <span class="tnum"><%= fmt.short(c.start_at) %></span>, <%= c.location %></li><% }) %>
      </ul>
      <p>Changez la date, ou publiez quand même si vos publics ne se recoupent pas.</p>
    </div>
  <% } %>

  <fieldset class="space-y-6">
    <legend class="h-section mb-6">Quoi, quand, où</legend>
    <% if (!event) { %>
      <% if (associations.length > 1) { %>
        <%- include('../../partials/field', { name: 'association_id', label: 'Association organisatrice', type: 'select', value: values.association_id, error: errors.association_id, options: associations.map((a) => [a.id, a.name]), cls: 'max-w-md' }) %>
      <% } else { %>
        <input type="hidden" name="association_id" value="<%= associations[0].id %>">
        <p class="flex items-center gap-2 text-ink-2"><span class="swatch size-3" style="background-color: <%= associations[0].color %>"></span>Publié au nom de <strong class="text-ink"><%= associations[0].name %></strong></p>
      <% } %>
    <% } %>
    <%- include('../../partials/field', { name: 'title', label: 'Titre', value: values.title, error: errors.title, required: true, attrs: 'maxlength="200"' }) %>
    <div class="grid gap-6 sm:grid-cols-2">
      <%- include('../../partials/field', { name: 'start', label: 'Début', type: 'datetime-local', value: values.start, error: errors.start, required: true, attrs: 'data-start' }) %>
      <%- include('../../partials/field', { name: 'end', label: 'Fin', type: 'datetime-local', value: values.end, error: errors.end, required: true, attrs: 'data-end' }) %>
    </div>
    <div id="live-conflicts" class="hidden" aria-live="polite"></div>
    <%- include('../../partials/field', { name: 'location', label: 'Lieu', help: 'Nom du lieu ou adresse.', value: values.location, error: errors.location, required: true, attrs: 'maxlength="255"' }) %>
    <%- include('../../partials/field', { name: 'description', label: 'Description', help: 'Programme, public visé, prix, accessibilité.', type: 'textarea', rows: 6, value: values.description, error: errors.description, required: true }) %>
    <%- include('../../partials/field', { name: 'category', label: 'Thème', type: 'select', value: values.category, options: Object.entries(CATEGORIES), cls: 'max-w-sm' }) %>
  </fieldset>

  <fieldset class="border-t border-line pt-10">
    <legend class="h-section mb-6 float-left w-full">Qui peut le voir</legend>
    <div class="clear-left space-y-2">
      <label class="choice"><input type="radio" name="visibility" value="public" class="mt-1" <%= values.visibility !== 'network' ? 'checked' : '' %>><span><span class="font-bold">Tout le monde</span><span class="block text-[15px] text-ink-2">Visible dans l'agenda public, même sans compte.</span></span></label>
      <label class="choice"><input type="radio" name="visibility" value="network" class="mt-1" <%= values.visibility === 'network' ? 'checked' : '' %>><span><span class="font-bold">Les associations seulement</span><span class="block text-[15px] text-ink-2">Pour une réunion de préparation ou un événement interne.</span></span></label>
    </div>
  </fieldset>

  <fieldset class="space-y-6 border-t border-line pt-10">
    <legend class="h-section mb-2 float-left w-full">Besoin d'aide ?</legend>
    <p class="hint clear-left">Les autres associations et les bénévoles pourront se proposer depuis la page de l'événement.</p>
    <%- include('../../partials/field', { name: 'volunteers_needed', label: 'Nombre de bénévoles recherchés', help: 'Laissez 0 si vous ne cherchez personne.', type: 'number', value: values.volunteers_needed, attrs: 'min="0" max="999" inputmode="numeric"', inputCls: 'max-w-[8rem]' }) %>
    <%- include('../../partials/field', { name: 'material_needs', label: 'Matériel recherché', optional: true, help: 'Par exemple : 2 barnums, 6 tables, une sono.', type: 'textarea', rows: 3, value: values.material_needs }) %>
  </fieldset>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-8">
    <button class="btn btn-primary"><%= conflicts.length ? 'Publier quand même' : (event ? 'Enregistrer les modifications' : 'Publier l’événement') %></button>
    <a href="<%= event ? `/evenements/${event.id}` : '/evenements' %>" class="link shrink-0 whitespace-nowrap text-[15px]">Annuler</a>
  </div>
</form>

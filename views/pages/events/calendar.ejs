<div class="mb-8 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
  <div>
    <p class="kicker mb-3" data-cal-title aria-live="polite">&nbsp;</p>
    <h1 class="h-page">Agenda</h1>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <a href="<%= user ? '/profil#agenda' : '/evenements/ical/public.ics' %>" class="btn btn-secondary">Ajouter à mon agenda</a>
    <% if (user) { %><a href="/evenements/nouveau" class="btn btn-primary">Publier une date</a><% } %>
  </div>
</div>

<div class="mb-4 space-y-3 border-t-2 border-ink py-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <button type="button" class="btn btn-secondary btn-icon" data-cal="prev" aria-label="Mois précédent"><%- icon('ChevronLeft') %></button>
      <button type="button" class="btn btn-secondary" data-cal="today">Ce mois-ci</button>
      <button type="button" class="btn btn-secondary btn-icon" data-cal="next" aria-label="Mois suivant"><%- icon('ChevronRight') %></button>
    </div>
    <%- include('../../partials/agenda-views', { current: 'mois' }) %>
  </div>
  <%- include('../../partials/agenda-filters', { attrs: 'data-cal-filters' }) %>
</div>

<div id="calendar" data-initial-date="<%= initialDate %>" data-can-create="<%= user ? '1' : '' %>" class="min-h-[640px]"></div>
<p class="meta mt-3">Une étiquette orange signale un jour avec plusieurs événements.<% if (user) { %> Cliquez sur un jour pour y publier une date.<% } %></p>

<div id="cal-tooltip" class="pointer-events-none fixed z-50 hidden w-72 rounded border border-line-strong bg-surface p-3.5 text-[14px] shadow-[0_12px_32px_-12px_rgba(0,0,0,0.35)]" role="tooltip"></div>

<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight sm:text-[28px]">Calendrier partagé</h1>
    <p class="mt-1.5 text-[15px] text-slate-500">Toutes les associations de <%= city %> sur un seul agenda. Repérez les dates libres avant de vous lancer.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="<%= user ? '/profil#agenda' : '/evenements/ical/public.ics' %>" class="btn btn-secondary"><%- icon('Rss') %>S'abonner</a>
    <% if (user) { %><a href="/evenements/nouveau" class="btn btn-primary"><%- icon('CalendarPlus') %>Nouvel événement</a><% } %>
  </div>
</div>

<div class="card overflow-hidden">
  <!-- Barre d'outils -->
  <div class="space-y-3 border-b border-slate-100 p-4 sm:p-5">
    <div class="flex flex-wrap items-center gap-2">
      <div class="flex rounded-lg ring-1 ring-inset ring-slate-200">
        <button type="button" class="btn btn-ghost btn-icon rounded-r-none" data-cal="prev" aria-label="Précédent"><%- icon('ChevronLeft') %></button>
        <button type="button" class="btn btn-ghost btn-icon rounded-l-none border-l border-slate-200" data-cal="next" aria-label="Suivant"><%- icon('ChevronRight') %></button>
      </div>
      <button type="button" class="btn btn-secondary" data-cal="today">Aujourd'hui</button>
      <h2 class="ml-1 whitespace-nowrap text-lg font-semibold capitalize sm:ml-2 sm:text-xl" data-cal-title></h2>
      <div class="segmented ml-auto" data-cal-views>
        <button type="button" data-view="dayGridMonth" class="active">Mois</button>
        <button type="button" data-view="timeGridWeek">Semaine</button>
        <button type="button" data-view="listMonth">Liste</button>
      </div>
    </div>
    <form class="flex flex-wrap items-center gap-2" data-cal-filters>
      <span class="mr-1 hidden items-center gap-1.5 text-sm font-medium text-slate-500 sm:inline-flex"><%- icon('Filter', 'size-3.5') %>Filtrer</span>
      <select name="association" class="input w-auto py-1.5" aria-label="Association">
        <option value="">Toutes les associations</option>
        <% associations.forEach((a) => { %><option value="<%= a.slug %>" <%= filters.association === a.slug ? 'selected' : '' %>><%= a.name %></option><% }) %>
      </select>
      <select name="theme" class="input w-auto py-1.5" aria-label="Thème">
        <option value="">Tous les thèmes</option>
        <% Object.entries(CATEGORIES).forEach(([v, l]) => { %><option value="<%= v %>" <%= filters.theme === v ? 'selected' : '' %>><%= l %></option><% }) %>
      </select>
      <% if (user) { %>
        <label class="chip cursor-pointer has-[:checked]:bg-slate-900 has-[:checked]:text-white has-[:checked]:ring-slate-900">
          <input type="checkbox" name="mes" value="1" class="sr-only" <%= filters.mes ? 'checked' : '' %>><%- icon('Users', 'size-3.5') %>Mes associations
        </label>
      <% } %>
    </form>
  </div>

  <div class="p-2 sm:p-3">
    <div id="calendar" data-initial-date="<%= initialDate %>" data-can-create="<%= user ? '1' : '' %>" class="min-h-[640px]"></div>
  </div>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-slate-100 px-5 py-3 text-xs text-slate-500">
    <span class="inline-flex items-center gap-1.5"><span class="h-3 w-5 rounded bg-brand-500"></span>Couleur de l'association</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-3 w-5 rounded bg-brand-500 bg-[repeating-linear-gradient(135deg,rgba(255,255,255,.35)_0_3px,transparent_3px_6px)]"></span>Réservé au réseau</span>
    <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-amber-500 ring-2 ring-amber-100"></span>Plusieurs événements ce jour-là</span>
    <% if (user) { %><span class="inline-flex items-center gap-1.5 sm:ml-auto"><%- icon('Plus', 'size-3.5') %>Cliquez sur un jour pour y ajouter un événement</span><% } %>
  </div>
</div>

<div id="cal-tooltip" class="pointer-events-none fixed z-50 hidden w-72 rounded-xl bg-slate-900 p-3.5 text-sm text-white shadow-2xl" role="tooltip"></div>

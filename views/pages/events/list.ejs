<div class="mb-8 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
  <div>
    <p class="kicker mb-3"><%= plural(events.length, 'événement') %> <%= past ? 'passés' : 'à venir' %></p>
    <h1 class="h-page">Agenda</h1>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <a href="<%= user ? '/profil#agenda' : '/evenements/ical/public.ics' %>" class="btn btn-secondary">Ajouter à mon agenda</a>
    <% if (user) { %><a href="/evenements/nouveau" class="btn btn-primary">Publier une date</a><% } %>
  </div>
</div>

<div class="mb-8 space-y-3 border-t-2 border-ink py-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <nav class="seg" aria-label="Période">
      <a href="/evenements/liste<%= query(filters, {}) %>" class="<%= !past ? 'active' : '' %>">À venir</a>
      <a href="/evenements/liste<%= query(filters, { passes: '1' }) %>" class="<%= past ? 'active' : '' %>">Passés</a>
    </nav>
    <%- include('../../partials/agenda-views', { current: 'liste' }) %>
  </div>
  <%- include('../../partials/agenda-filters', { hidden: past ? [['passes', '1']] : [] }) %>
</div>

<% if (events.length) { %>
  <div class="max-w-4xl"><%- include('../../partials/agenda', { events }) %></div>
<% } else { %>
  <p class="border-t-2 border-ink py-6 text-ink-2">Aucun événement<%= filters.association || filters.theme || filters.mes ? ' avec ces filtres' : '' %>.<% if (user) { %> <a class="link" href="/evenements/nouveau">Publier une date</a><% } %></p>
<% } %>

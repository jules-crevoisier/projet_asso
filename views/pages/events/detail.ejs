<p class="mb-6"><a href="/evenements" class="link shrink-0 whitespace-nowrap text-[15px]">Retour à l'agenda</a></p>

<header class="mb-10 border-b border-line pb-8">
  <p class="kicker mb-3 flex flex-wrap items-center gap-2">
    <span class="swatch size-3" style="background-color: <%= event.association_color %>"></span>
    <a class="link-quiet normal-case tracking-normal" href="/associations/<%= event.association_slug %>"><%= event.association_name %></a>
    <span aria-hidden="true">·</span><span><%= CATEGORIES[event.category] %></span>
    <% if (event.visibility === 'network') { %><span aria-hidden="true">·</span><span>Réservé aux associations</span><% } %>
  </p>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <h1 class="h-page max-w-3xl"><%= event.title %></h1>
    <div class="flex shrink-0 flex-wrap gap-2">
      <a href="/evenements/<%= event.id %>/evenement.ics" class="btn btn-secondary">Ajouter à mon agenda</a>
      <% if (canEdit) { %>
        <a href="/evenements/<%= event.id %>/modifier" class="btn btn-secondary">Modifier</a>
        <form method="post" action="/evenements/<%= event.id %>/supprimer" data-confirm="Supprimer définitivement cet événement ?">
          <%- include('../../partials/csrf') %><button class="btn btn-danger">Supprimer</button>
        </form>
      <% } %>
    </div>
  </div>
  <dl class="mt-8 grid gap-6 sm:grid-cols-2 lg:max-w-3xl">
    <div><dt class="meta">Quand</dt><dd class="tnum mt-0.5 text-[20px] first-letter:uppercase"><%= fmt.range(event.start_at, event.end_at) %></dd></div>
    <div><dt class="meta">Où</dt><dd class="mt-0.5 font-serif text-[20px]"><%= event.location %></dd></div>
  </dl>
</header>

<% if (conflicts.length) { %>
  <div class="notice notice-warn mb-10 flex-col gap-1">
    <p class="font-bold">Sur le même créneau</p>
    <ul class="space-y-0.5">
      <% conflicts.forEach((c) => { %><li><span class="swatch mr-1.5" style="background-color: <%= c.association_color %>"></span><a class="link-quiet font-semibold" href="/evenements/<%= c.id %>"><%= c.title %></a>, <%= c.association_name %>, <span class="tnum"><%= fmt.time(c.start_at) %>–<%= fmt.time(c.end_at) %></span>, <%= c.location %></li><% }) %>
    </ul>
  </div>
<% } %>

<div class="grid gap-x-16 gap-y-12 lg:grid-cols-[2fr_1fr]">
  <div class="space-y-12">
    <section aria-label="Description">
      <div class="prose-text text-[17px]"><%= event.description %></div>
    </section>

    <% if (user) { %>
      <section id="discussion" aria-labelledby="discussion-titre">
        <h2 id="discussion-titre" class="h-section mb-1 border-b border-ink pb-2">Discussion <span class="font-sans text-[16px] font-normal text-ink-3"><%= comments.length %></span></h2>
        <p class="meta mb-4">Visible par les membres connectés : questions, propositions d'aide, organisation.</p>
        <ol class="rows">
          <% comments.forEach((c) => { %>
            <li class="flex gap-3 py-4">
              <%- include('../../partials/avatar', { first: c.first_name, last: c.last_name }) %>
              <div class="min-w-0 flex-1">
                <p class="flex flex-wrap items-baseline gap-x-2"><strong><%= c.first_name %> <%= c.last_name %></strong><span class="meta"><%= fmt.ago(c.created_at) %></span></p>
                <p class="prose-text mt-1"><%= c.body %></p>
                <% if (c.user_id === user.id || canEdit) { %>
                  <form method="post" action="/evenements/commentaires/<%= c.id %>/supprimer" class="mt-1" data-confirm="Supprimer ce message ?"><%- include('../../partials/csrf') %><button class="link-quiet text-[14px] text-ink-3">Supprimer</button></form>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ol>
        <form method="post" action="/evenements/<%= event.id %>/commentaires" class="mt-4 space-y-3 border-t border-line pt-5">
          <%- include('../../partials/csrf') %>
          <label for="comment" class="label">Écrire un message</label>
          <textarea id="comment" name="body" rows="3" class="input" required></textarea>
          <button class="btn btn-primary">Envoyer</button>
        </form>
      </section>
    <% } else { %>
      <p class="notice notice-info">Vous représentez une association ? <a class="link ml-1" href="/connexion">Connectez-vous</a> pour proposer votre aide, vous inscrire comme bénévole ou écrire aux organisateurs.</p>
    <% } %>
  </div>

  <aside class="space-y-10">
    <% if (event.volunteers_needed || event.material_needs) { %>
      <section>
        <h2 class="h-block mb-3 border-b border-ink pb-2">Besoins</h2>
        <% if (event.volunteers_needed) { const pct = Math.min(100, Math.round(event.nb_volunteers / event.volunteers_needed * 100)); %>
          <p class="flex items-baseline justify-between"><span class="font-bold">Bénévoles</span><span class="tnum text-ink-2"><strong class="text-ink"><%= event.nb_volunteers %></strong> sur <%= event.volunteers_needed %></span></p>
          <div class="mt-2 h-2 overflow-hidden rounded-full bg-line" role="progressbar" aria-valuenow="<%= event.nb_volunteers %>" aria-valuemin="0" aria-valuemax="<%= event.volunteers_needed %>" aria-label="Bénévoles inscrits"><div class="h-full bg-ink" style="width: <%= pct %>%"></div></div>
          <% if (user) { %>
            <form method="post" action="/evenements/<%= event.id %>/benevole" class="mt-4">
              <%- include('../../partials/csrf') %>
              <% if (isVolunteer) { %><p class="mb-2 text-[15px] text-success">Vous êtes inscrit·e.</p><button class="btn btn-secondary w-full">Me désinscrire</button>
              <% } else { %><button class="btn btn-primary w-full">Je me propose comme bénévole</button><% } %>
            </form>
          <% } %>
          <% if (volunteers.length) { %>
            <ul class="mt-5 space-y-2 border-t border-line pt-4 text-[15px]">
              <% volunteers.forEach((v) => { %>
                <li><span class="font-semibold"><%= v.first_name %> <%= v.last_name %></span><br><a class="link-quiet text-ink-2" href="mailto:<%= v.email %>"><%= v.email %></a><% if (v.phone) { %> · <a class="link-quiet tnum text-ink-2" href="tel:<%= v.phone.replace(/\s/g, '') %>"><%= v.phone %></a><% } %></li>
              <% }) %>
            </ul>
          <% } %>
        <% } %>
        <% if (event.material_needs) { %>
          <div class="<%= event.volunteers_needed ? 'mt-6 border-t border-line pt-4' : '' %>">
            <p class="font-bold">Matériel recherché</p>
            <p class="prose-text mt-1 text-ink-2"><%= event.material_needs %></p>
          </div>
        <% } %>
      </section>
    <% } %>

    <section>
      <h2 class="h-block mb-3 border-b border-ink pb-2">Associations impliquées</h2>
      <ul class="space-y-4">
        <li>
          <p class="flex items-center gap-2"><span class="swatch size-3" style="background-color: <%= event.association_color %>"></span><a class="link-quiet font-semibold" href="/associations/<%= event.association_slug %>"><%= event.association_name %></a></p>
          <p class="meta pl-5">Organisatrice</p>
        </li>
        <% participations.forEach((p) => { %>
          <li>
            <p class="flex items-center gap-2"><span class="swatch size-3" style="background-color: <%= p.color %>"></span><a class="link-quiet font-semibold" href="/associations/<%= p.slug %>"><%= p.name %></a></p>
            <p class="meta pl-5"><%= PARTICIPATION_KINDS[p.kind] %></p>
            <% if (p.message) { %><p class="mt-1 pl-5 text-[15px] text-ink-2">« <%= p.message %> »</p><% } %>
            <% if (user && (canEdit || myAssociationIds.has(p.association_id))) { %>
              <form method="post" action="/evenements/participations/<%= p.id %>/supprimer" class="pl-5" data-confirm="Retirer cette association de l'événement ?"><%- include('../../partials/csrf') %><button class="link-quiet text-[14px] text-ink-3">Retirer</button></form>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <% if (availableAssociations.length) { %>
        <button type="button" class="btn btn-secondary mt-5 w-full" data-toggle="#participate-form" aria-controls="participate-form" aria-expanded="false">Associer mon association</button>
        <form id="participate-form" method="post" action="/evenements/<%= event.id %>/participer" class="mt-4 hidden space-y-5 border-l-4 border-ink bg-surface p-4">
          <%- include('../../partials/csrf') %>
          <% if (availableAssociations.length > 1) { %>
            <%- include('../../partials/field', { name: 'association_id', label: 'Au nom de', type: 'select', options: availableAssociations.map((a) => [a.id, a.name]) }) %>
          <% } else { %>
            <input type="hidden" name="association_id" value="<%= availableAssociations[0].id %>">
            <p>Au nom de <strong><%= availableAssociations[0].name %></strong></p>
          <% } %>
          <fieldset>
            <legend class="label">Votre rôle</legend>
            <div class="space-y-2">
              <% Object.entries(PARTICIPATION_KINDS).forEach(([v, l], i) => { %>
                <label class="choice items-center py-2.5"><input type="radio" name="kind" value="<%= v %>" <%= i === 1 ? 'checked' : '' %>><span class="text-[15px]"><%= l %></span></label>
              <% }) %>
            </div>
          </fieldset>
          <%- include('../../partials/field', { name: 'message', label: 'Message', optional: true, help: 'Par exemple : « on apporte deux barnums ».', attrs: 'maxlength="300"' }) %>
          <button class="btn btn-primary">Confirmer</button>
        </form>
      <% } %>
    </section>
  </aside>
</div>

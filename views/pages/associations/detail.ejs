<div class="card mb-6 overflow-hidden">
  <div class="relative h-32 sm:h-40" style="background: linear-gradient(120deg, <%= association.color %>, <%= association.color %>bb 60%, <%= association.color %>66)">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(255,255,255,0.25),transparent_50%)]"></div>
  </div>
  <div class="relative px-5 pb-6 sm:px-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex items-end gap-4">
        <span class="-mt-10 shrink-0 rounded-3xl bg-white p-1.5 shadow-md"><%- include('../../partials/avatar', { first: association.name, color: association.color, size: 'size-20 text-2xl rounded-2xl' }) %></span>
        <div class="min-w-0 pb-1 pt-3">
          <h1 class="text-2xl font-bold tracking-tight"><%= association.name %></h1>
          <div class="mt-1.5 flex flex-wrap gap-2">
            <span class="badge badge-slate"><%= CATEGORIES[association.category] %></span>
            <% if (association.is_validated) { %><span class="badge badge-emerald"><%- icon('BadgeCheck', 'size-3') %>Validée</span><% } else { %><span class="badge badge-amber"><%- icon('Hourglass', 'size-3') %>En attente de validation</span><% } %>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if (user && user.is_staff && !association.is_validated) { %>
          <form method="post" action="/associations/<%= association.slug %>/valider"><%- include('../../partials/csrf') %><button class="btn btn-primary"><%- icon('BadgeCheck') %>Valider</button></form>
        <% } %>
        <% if (isAdmin) { %>
          <a href="/associations/<%= association.slug %>/membres" class="btn btn-secondary"><%- icon('Users') %>Membres</a>
          <a href="/associations/<%= association.slug %>/modifier" class="btn btn-secondary"><%- icon('Pencil') %>Modifier</a>
        <% } %>
        <% if (!user) { %>
          <a href="/connexion" class="btn btn-primary"><%- icon('UserPlus') %>Rejoindre</a>
        <% } else if (!membership) { %>
          <button type="button" class="btn btn-primary" data-toggle="#join-form"><%- icon('UserPlus') %>Rejoindre</button>
        <% } else if (membership.status === 'pending') { %>
          <span class="btn btn-secondary pointer-events-none"><%- icon('Hourglass') %>Demande envoyée</span>
        <% } else { %>
          <span class="btn btn-secondary pointer-events-none text-emerald-700"><%- icon('CircleCheck') %><%= membership.role === 'admin' ? 'Responsable' : 'Membre' %></span>
        <% } %>
      </div>
    </div>

    <% if (user && !membership) { %>
      <form id="join-form" method="post" action="/associations/<%= association.slug %>/rejoindre" class="mt-6 hidden rounded-xl bg-slate-50 p-4 ring-1 ring-slate-900/5">
        <%- include('../../partials/csrf') %>
        <%- include('../../partials/field', { name: 'message', label: 'Un mot pour les responsables (facultatif)', placeholder: 'Ex. : je suis bénévole depuis 2023 sur la buvette', attrs: 'maxlength="300"' }) %>
        <div class="mt-3 flex justify-end"><button class="btn btn-primary">Envoyer ma demande</button></div>
      </form>
    <% } %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <section class="card card-pad">
      <p class="text-lg font-medium leading-snug text-slate-900"><%= association.short_description %></p>
      <% if (association.description) { %><div class="prose-text mt-4"><%= association.description %></div><% } %>
    </section>

    <section class="card overflow-hidden">
      <div class="card-header"><h2 class="card-title">Événements à venir</h2><a class="card-link" href="/evenements?association=<%= association.slug %>">Voir au calendrier <%- icon('ArrowRight', 'size-3.5') %></a></div>
      <div class="divide-list">
        <% if (events.length) { events.forEach((event) => { %>
          <%- include('../../partials/event-row', { event }) %>
        <% }) } else { %>
          <%- include('../../partials/empty', { iconName: 'CalendarDays', heading: 'Aucun événement à venir' }) %>
        <% } %>
      </div>
    </section>

    <% if (posts.length) { %>
      <section class="card overflow-hidden">
        <div class="card-header"><h2 class="card-title">Annonces en cours</h2></div>
        <div class="divide-list"><% posts.forEach((post) => { %><%- include('../../partials/post-row', { post }) %><% }) %></div>
      </section>
    <% } %>
  </div>

  <div class="space-y-6">
    <section class="card card-pad">
      <h2 class="card-title mb-4">Contact</h2>
      <ul class="space-y-3 text-sm">
        <% if (association.email) { %><li class="flex items-center gap-3"><%- icon('Mail', 'size-4 text-slate-400') %><a class="truncate text-brand-700 hover:underline" href="mailto:<%= association.email %>"><%= association.email %></a></li><% } %>
        <% if (association.phone) { %><li class="flex items-center gap-3"><%- icon('Phone', 'size-4 text-slate-400') %><%= association.phone %></li><% } %>
        <% if (association.website) { %><li class="flex items-center gap-3"><%- icon('Globe', 'size-4 text-slate-400') %><a class="truncate text-brand-700 hover:underline" href="<%= association.website %>" target="_blank" rel="noopener"><%= association.website.replace(/^https?:\/\//, '') %></a></li><% } %>
        <% if (association.address) { %><li class="flex items-center gap-3"><%- icon('MapPin', 'size-4 text-slate-400') %><%= association.address %></li><% } %>
        <% if (!association.email && !association.phone && !association.website && !association.address) { %><li class="text-slate-500">Pas de coordonnées renseignées.</li><% } %>
      </ul>
    </section>

    <section class="card overflow-hidden">
      <div class="card-header"><h2 class="card-title">Membres</h2><% if (user) { %><span class="text-sm text-slate-500"><%= members.length %></span><% } %></div>
      <% if (user) { %>
        <div class="divide-list">
          <% members.forEach((m) => { %>
            <div class="flex items-center gap-3 px-5 py-2.5 sm:px-6">
              <%- include('../../partials/avatar', { first: m.first_name, last: m.last_name }) %>
              <span class="flex-1 text-sm font-medium"><%= m.first_name %> <%= m.last_name %></span>
              <% if (m.role === 'admin') { %><span class="badge badge-brand"><%- icon('Crown', 'size-3') %>Responsable</span><% } %>
            </div>
          <% }) %>
        </div>
        <% if (membership) { %>
          <form method="post" action="/associations/<%= association.slug %>/quitter" class="border-t border-slate-100 px-5 py-3 sm:px-6" data-confirm="<%= membership.status === 'pending' ? 'Annuler votre demande ?' : 'Quitter cette association ?' %>">
            <%- include('../../partials/csrf') %>
            <button class="text-sm font-medium text-slate-500 hover:text-red-600"><%= membership.status === 'pending' ? 'Annuler ma demande' : 'Quitter l’association' %></button>
          </form>
        <% } %>
      <% } else { %>
        <p class="px-5 py-4 text-sm text-slate-500 sm:px-6"><a class="font-medium text-brand-700 hover:underline" href="/connexion">Connectez-vous</a> pour voir les membres.</p>
      <% } %>
    </section>
  </div>
</div>

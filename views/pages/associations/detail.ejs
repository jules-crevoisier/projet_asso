<div class="mb-10 border-b border-line pb-8">
  <p class="kicker mb-3 flex items-center gap-2"><span class="swatch size-3" style="background-color: <%= association.color %>"></span><%= CATEGORIES[association.category] %><% if (!association.is_validated) { %> · <span class="text-warn">En attente de validation</span><% } %></p>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <h1 class="h-page"><%= association.name %></h1>
      <p class="lead mt-3"><%= association.short_description %></p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2">
      <% if (user && user.is_staff && !association.is_validated) { %>
        <form method="post" action="/associations/<%= association.slug %>/valider"><%- include('../../partials/csrf') %><button class="btn btn-primary">Valider l'association</button></form>
      <% } %>
      <% if (!user) { %>
        <a href="/connexion" class="btn btn-primary">Se connecter pour rejoindre</a>
      <% } else if (!membership) { %>
        <button type="button" class="btn btn-primary" data-toggle="#join-form" aria-controls="join-form" aria-expanded="false">Demander à rejoindre</button>
      <% } else if (membership.status === 'pending') { %>
        <p class="tag tag-warn px-2.5 py-1.5 text-[14px]">Demande envoyée, en attente</p>
      <% } %>
      <% if (isAdmin) { %>
        <a href="/associations/<%= association.slug %>/membres" class="btn btn-secondary">Gérer les membres</a>
        <a href="/associations/<%= association.slug %>/modifier" class="btn btn-secondary">Modifier la fiche</a>
      <% } %>
    </div>
  </div>

  <% if (user && !membership) { %>
    <form id="join-form" method="post" action="/associations/<%= association.slug %>/rejoindre" class="mt-6 hidden max-w-xl space-y-4 border-l-4 border-ink bg-surface p-5">
      <%- include('../../partials/csrf') %>
      <%- include('../../partials/field', { name: 'message', label: 'Un mot pour les responsables', optional: true, help: 'Par exemple : « je tiens la buvette depuis 2023 ».', attrs: 'maxlength="300"' }) %>
      <button class="btn btn-primary">Envoyer ma demande</button>
    </form>
  <% } %>
</div>

<div class="grid gap-x-16 gap-y-12 lg:grid-cols-[2fr_1fr]">
  <div class="space-y-12">
    <% if (association.description) { %>
      <section aria-labelledby="presentation">
        <h2 id="presentation" class="h-section mb-4">Présentation</h2>
        <div class="prose-text"><%= association.description %></div>
      </section>
    <% } %>

    <section aria-labelledby="evenements">
      <div class="mb-4 flex items-baseline justify-between gap-4 border-b border-ink pb-2">
        <h2 id="evenements" class="h-section">Prochains événements</h2>
        <a class="link shrink-0 whitespace-nowrap text-[15px]" href="/evenements?association=<%= association.slug %>">Dans l'agenda</a>
      </div>
      <% if (events.length) { %>
        <%- include('../../partials/agenda', { events, showCount: false }) %>
      <% } else { %>
        <p class="py-4 text-ink-2">Aucun événement annoncé pour l'instant.</p>
      <% } %>
    </section>

    <% if (posts.length) { %>
      <section aria-labelledby="annonces">
        <h2 id="annonces" class="h-section mb-1 border-b border-ink pb-2">Annonces en cours</h2>
        <div class="rows -mx-5"><% posts.forEach((post) => { %><%- include('../../partials/post-row', { post }) %><% }) %></div>
      </section>
    <% } %>
  </div>

  <aside class="space-y-10">
    <section>
      <h2 class="h-block mb-3 border-b border-ink pb-2">Contact</h2>
      <dl class="space-y-3">
        <% if (association.email) { %><div><dt class="meta">E-mail</dt><dd><a class="link break-all" href="mailto:<%= association.email %>"><%= association.email %></a></dd></div><% } %>
        <% if (association.phone) { %><div><dt class="meta">Téléphone</dt><dd><a class="link-quiet tnum" href="tel:<%= association.phone.replace(/\s/g, '') %>"><%= association.phone %></a></dd></div><% } %>
        <% if (association.website) { %><div><dt class="meta">Site</dt><dd><a class="link break-all" href="<%= association.website %>" target="_blank" rel="noopener"><%= association.website.replace(/^https?:\/\//, '').replace(/\/$/, '') %></a></dd></div><% } %>
        <% if (association.address) { %><div><dt class="meta">Adresse</dt><dd><%= association.address %></dd></div><% } %>
        <% if (!association.email && !association.phone && !association.website && !association.address) { %><p class="text-ink-2">Pas de coordonnées renseignées.</p><% } %>
      </dl>
    </section>

    <section>
      <h2 class="h-block mb-3 flex items-baseline justify-between border-b border-ink pb-2">Membres<% if (user) { %><span class="font-sans text-[14px] font-normal text-ink-3"><%= members.length %></span><% } %></h2>
      <% if (user) { %>
        <ul class="space-y-2">
          <% members.forEach((m) => { %>
            <li class="flex items-center gap-3">
              <%- include('../../partials/avatar', { first: m.first_name, last: m.last_name }) %>
              <span class="flex-1"><%= m.first_name %> <%= m.last_name %></span>
              <% if (m.role === 'admin') { %><span class="text-[13px] text-ink-3">Responsable</span><% } %>
            </li>
          <% }) %>
        </ul>
        <% if (membership) { %>
          <form method="post" action="/associations/<%= association.slug %>/quitter" class="mt-5" data-confirm="<%= membership.status === 'pending' ? 'Annuler votre demande ?' : 'Quitter cette association ?' %>">
            <%- include('../../partials/csrf') %>
            <button class="link-quiet text-[15px] text-ink-2"><%= membership.status === 'pending' ? 'Annuler ma demande' : 'Quitter l’association' %></button>
          </form>
        <% } %>
      <% } else { %>
        <p class="text-ink-2"><a class="link" href="/connexion">Connectez-vous</a> pour voir les membres.</p>
      <% } %>
    </section>
  </aside>
</div>

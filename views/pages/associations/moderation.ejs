<%- include('../../partials/page-header', { heading: 'Modération', subtitle: 'Associations en attente de validation. Vérifiez qu’elles existent (site, réseaux, Journal officiel) avant de les valider.' }) %>

<% if (pending.length) { %>
  <ul class="rows border-y border-line">
    <% pending.forEach((a) => { %>
      <li class="flex flex-col gap-4 py-5 sm:flex-row sm:items-start">
        <div class="min-w-0 flex-1">
          <h2 class="font-sans text-[17px] font-bold"><a class="link-quiet" href="/associations/<%= a.slug %>"><%= a.name %></a></h2>
          <p class="mt-0.5 max-w-prose text-ink-2"><%= a.short_description %></p>
          <p class="meta mt-1"><%= CATEGORIES[a.category] %> · inscrite <%= fmt.ago(a.created_at) %><% if (a.creator_email) { %> par <%= a.first_name %> <%= a.last_name %>, <a class="link-quiet" href="mailto:<%= a.creator_email %>"><%= a.creator_email %></a><% } %></p>
        </div>
        <form method="post" action="/associations/<%= a.slug %>/valider"><%- include('../../partials/csrf') %><button class="btn btn-primary">Valider</button></form>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p class="text-ink-2">Aucune association en attente.</p>
<% } %>

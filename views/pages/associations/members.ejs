<p class="mb-4"><a class="link shrink-0 whitespace-nowrap text-[15px]" href="/associations/<%= association.slug %>">Retour à la fiche de <%= association.name %></a></p>
<%- include('../../partials/page-header', {
  heading: 'Membres',
  subtitle: 'Les membres publient au nom de l’association. Les responsables gèrent en plus la fiche et les adhésions.',
}) %>

<% const pendingList = memberships.filter((m) => m.status === 'pending'); const active = memberships.filter((m) => m.status === 'active'); %>

<% if (pendingList.length) { %>
  <section class="mb-12" aria-labelledby="attente">
    <h2 id="attente" class="h-section mb-1 border-b border-ink pb-2">En attente <span class="text-accent"><%= pendingList.length %></span></h2>
    <ul class="rows">
      <% pendingList.forEach((m) => { const base = `/associations/${association.slug}/membres/${m.id}`; %>
        <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center">
          <div class="min-w-0 flex-1">
            <p class="font-bold"><%= m.first_name %> <%= m.last_name %></p>
            <p class="meta"><a class="link-quiet" href="mailto:<%= m.email %>"><%= m.email %></a></p>
            <% if (m.message) { %><p class="mt-1 max-w-prose text-ink-2">« <%= m.message %> »</p><% } %>
          </div>
          <div class="flex gap-2">
            <form method="post" action="<%= base %>/accepter"><%- include('../../partials/csrf') %><button class="btn btn-primary btn-sm">Accepter</button></form>
            <form method="post" action="<%= base %>/retirer"><%- include('../../partials/csrf') %><button class="btn btn-secondary btn-sm">Refuser</button></form>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section aria-labelledby="actifs">
  <h2 id="actifs" class="h-section mb-1 border-b border-ink pb-2">Membres actifs <span class="font-sans text-[16px] font-normal text-ink-3"><%= active.length %></span></h2>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[36rem] text-left">
      <thead><tr class="border-b border-line text-[13px] text-ink-3"><th class="py-2.5 pr-4 font-bold">Nom</th><th class="py-2.5 pr-4 font-bold">Contact</th><th class="py-2.5 pr-4 font-bold">Rôle</th><th class="py-2.5"><span class="sr-only">Actions</span></th></tr></thead>
      <tbody class="rows">
        <% active.forEach((m) => { const base = `/associations/${association.slug}/membres/${m.id}`; %>
          <tr>
            <td class="py-3 pr-4 font-semibold"><%= m.first_name %> <%= m.last_name %></td>
            <td class="py-3 pr-4 text-[15px]"><a class="link-quiet" href="mailto:<%= m.email %>"><%= m.email %></a><% if (m.phone) { %><span class="tnum block text-ink-3"><%= m.phone %></span><% } %></td>
            <td class="py-3 pr-4 text-[15px]"><%= m.role === 'admin' ? 'Responsable' : 'Membre' %></td>
            <td class="py-3 text-right">
              <div class="flex justify-end gap-2">
                <% if (m.role === 'member') { %>
                  <form method="post" action="<%= base %>/promouvoir"><%- include('../../partials/csrf') %><button class="btn btn-secondary btn-sm">Nommer responsable</button></form>
                <% } else { %>
                  <form method="post" action="<%= base %>/retrograder"><%- include('../../partials/csrf') %><button class="btn btn-secondary btn-sm">Retirer le rôle</button></form>
                <% } %>
                <form method="post" action="<%= base %>/retirer" data-confirm="Retirer <%= m.first_name %> de l'association ?"><%- include('../../partials/csrf') %><button class="btn btn-danger btn-sm">Retirer</button></form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

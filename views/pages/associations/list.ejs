<%- include('../../partials/page-header', {
  heading: 'Annuaire des associations',
  subtitle: `${associations.length} association${associations.length > 1 ? 's' : ''} à ${city}`,
  actions: user ? `<a href="/associations/nouvelle" class="btn btn-primary">${icon('Plus')}Inscrire une association</a>` : '',
}) %>

<form method="get" class="mb-6 space-y-4" data-autosubmit>
  <div class="relative max-w-md">
    <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-slate-400"><%- icon('Search') %></span>
    <input type="search" name="q" value="<%= q %>" placeholder="Rechercher une association…" class="input pl-9" aria-label="Rechercher">
    <% if (category) { %><input type="hidden" name="categorie" value="<%= category %>"><% } %>
  </div>
  <div class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1">
    <a href="/associations<%= query({ q }, {}) %>" class="chip <%= !category ? 'active' : '' %>">Toutes</a>
    <% Object.entries(CATEGORIES).forEach(([value, label]) => { %>
      <a href="/associations<%= query({ q }, { categorie: value }) %>" class="chip shrink-0 <%= category === value ? 'active' : '' %>"><%= label %></a>
    <% }) %>
  </div>
</form>

<% if (associations.length) { %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% associations.forEach((a) => { %>
      <a href="/associations/<%= a.slug %>" class="card group relative flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg">
        <div class="h-16" style="background: linear-gradient(135deg, <%= a.color %>, <%= a.color %>99)"></div>
        <div class="flex flex-1 flex-col px-5 pb-5">
          <div class="-mt-7 mb-3 flex items-end justify-between">
            <span class="rounded-2xl bg-white p-1 shadow-sm"><%- include('../../partials/avatar', { first: a.name, color: a.color, size: 'size-12 text-base rounded-xl' }) %></span>
            <% if (a.is_validated) { %><span class="badge badge-emerald"><%- icon('BadgeCheck', 'size-3') %>Validée</span><% } else { %><span class="badge badge-amber">En validation</span><% } %>
          </div>
          <h3 class="font-semibold text-slate-900 group-hover:text-brand-700"><%= a.name %></h3>
          <p class="mt-1 line-clamp-2 flex-1 text-sm text-slate-600"><%= a.short_description %></p>
          <div class="mt-4 flex items-center gap-4 border-t border-slate-100 pt-3 text-xs text-slate-500">
            <span class="badge badge-slate"><%= CATEGORIES[a.category] %></span>
            <span class="inline-flex items-center gap-1"><%- icon('Users', 'size-3.5') %><%= a.nb_members %></span>
            <span class="inline-flex items-center gap-1"><%- icon('CalendarDays', 'size-3.5') %><%= a.nb_events %> à venir</span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
<% } else { %>
  <div class="card"><%- include('../../partials/empty', { iconName: 'Search', heading: 'Aucune association trouvée', text: 'Essayez un autre mot-clé, ou inscrivez la vôtre.', actionHref: user ? '/associations/nouvelle' : '/inscription', actionLabel: 'Inscrire une association' }) %></div>
<% } %>

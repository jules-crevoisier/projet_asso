<%
  const letterOf = (name) => name.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/^(les?|la|l['’])\s*/i, '').charAt(0).toUpperCase();
  const sortKey = (name) => name.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/^(les?|la|l['’])\s*/i, '');
  const sorted = [...associations].sort((a, b) => sortKey(a.name).localeCompare(sortKey(b.name), 'fr', { sensitivity: 'base' }));
  const groups = [];
  sorted.forEach((a) => {
    const l = /[A-Z]/.test(letterOf(a.name)) ? letterOf(a.name) : '#';
    if (!groups.length || groups[groups.length - 1].letter !== l) groups.push({ letter: l, items: [] });
    groups[groups.length - 1].items.push(a);
  });
%>
<%- include('../../partials/page-header', {
  heading: 'Associations',
  subtitle: `${plural(associations.length, 'association inscrite', 'associations inscrites')}${category ? ` en « ${CATEGORIES[category]} »` : ''}${q ? ` pour « ${q} »` : ''}.`,
  actions: user ? `<a href="/associations/nouvelle" class="btn btn-secondary">Inscrire une association</a>` : '',
}) %>

<div class="grid gap-x-16 gap-y-10 lg:grid-cols-[14rem_1fr]">
  <aside>
    <form method="get" role="search" class="mb-6">
      <label for="q" class="label">Rechercher</label>
      <div class="flex gap-2">
        <input id="q" type="search" name="q" value="<%= q %>" class="input" placeholder="Nom, activité…">
        <% if (category) { %><input type="hidden" name="categorie" value="<%= category %>"><% } %>
        <button class="btn btn-secondary btn-icon" aria-label="Lancer la recherche"><%- icon('Search') %></button>
      </div>
    </form>
    <p class="kicker mb-2">Domaine</p>
    <nav class="-mx-3 flex gap-1 overflow-x-auto lg:flex-col" aria-label="Filtrer par domaine">
      <a href="/associations<%= query({ q }, {}) %>" class="side-link shrink-0 <%= !category ? 'active' : '' %>" <%= !category ? 'aria-current=page' : '' %>>Tous</a>
      <% Object.entries(CATEGORIES).forEach(([value, label]) => { %>
        <a href="/associations<%= query({ q }, { categorie: value }) %>" class="side-link shrink-0 <%= category === value ? 'active' : '' %>" <%= category === value ? 'aria-current=page' : '' %>><%= label %></a>
      <% }) %>
    </nav>
  </aside>

  <div>
    <% if (associations.length) { %>
      <div class="space-y-10">
        <% groups.forEach((g) => { %>
          <section aria-label="Lettre <%= g.letter %>">
            <h2 class="border-t-2 border-ink pt-3 pb-1 text-[28px] font-bold tracking-[-0.03em] leading-none"><%= g.letter %></h2>
            <ul class="rows">
              <% g.items.forEach((a) => { %>
                <li class="group relative grid gap-x-4 py-4 sm:grid-cols-[1fr_auto]">
                  <div class="flex gap-3">
                    <span class="swatch mt-[7px] size-3" style="background-color: <%= a.color %>"></span>
                    <div class="min-w-0">
                      <h3 class="text-[17px] font-semibold leading-snug">
                        <a href="/associations/<%= a.slug %>" class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-[3px]"><%= a.name %></a>
                        <% if (!a.is_validated) { %><span class="tag tag-warn ml-1 align-[2px]">En validation</span><% } %>
                      </h3>
                      <p class="mt-0.5 max-w-prose text-ink-2"><%= a.short_description %></p>
                    </div>
                  </div>
                  <p class="meta mt-1 pl-6 sm:mt-0.5 sm:pl-0 sm:text-right">
                    <%= CATEGORIES[a.category] %><br class="hidden sm:inline"><span class="sm:hidden"> · </span><%= plural(a.nb_members, 'membre') %> · <%= a.nb_events %> à venir
                  </p>
                </li>
              <% }) %>
            </ul>
          </section>
        <% }) %>
      </div>
    <% } else { %>
      <div class="panel"><%- include('../../partials/empty', { heading: 'Aucune association trouvée', text: 'Essayez un autre mot, ou inscrivez la vôtre si elle n’y est pas.', actionHref: user ? '/associations/nouvelle' : '/inscription', actionLabel: 'Inscrire une association' }) %></div>
    <% } %>
  </div>
</div>

<div class="max-w-md">
  <h1 class="h-page">Mot de passe oublié</h1>
  <% if (sent) { %>
    <div class="notice notice-success mt-8"><p><strong>Vérifiez votre boîte mail.</strong> Si un compte correspond à cette adresse, nous venons d'y envoyer un lien. Il est valable une heure.</p></div>
    <p class="mt-6"><a class="link" href="/connexion">Revenir à la connexion</a></p>
  <% } else { %>
    <p class="mt-3 text-ink-2">Indiquez l'adresse de votre compte : nous vous envoyons un lien pour choisir un nouveau mot de passe.</p>
    <form method="post" action="/mot-de-passe-oublie" class="mt-8 space-y-6">
      <%- include('../../partials/csrf') %>
      <%- include('../../partials/field', { name: 'email', label: 'Adresse e-mail', type: 'email', required: true, attrs: 'autocomplete="email" autofocus spellcheck="false"' }) %>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <button class="btn btn-primary">Envoyer le lien</button>
        <a class="link shrink-0 whitespace-nowrap text-[15px]" href="/connexion">Annuler</a>
      </div>
    </form>
  <% } %>
</div>

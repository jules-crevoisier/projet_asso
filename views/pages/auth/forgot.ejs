<%- include('_shell-start', { heading: 'Mot de passe oublié', sub: 'Indiquez votre e-mail, nous vous envoyons un lien pour en choisir un nouveau.' }) %>
  <% if (sent) { %>
    <div class="flex flex-col items-center text-center">
      <span class="grid size-12 place-items-center rounded-full bg-emerald-50 text-emerald-600"><%- icon('Mail', 'size-6') %></span>
      <p class="mt-4 font-semibold">Vérifiez votre boîte mail</p>
      <p class="mt-1 text-sm text-slate-500">Si un compte correspond à cette adresse, un lien valable une heure vient d'être envoyé.</p>
    </div>
  <% } else { %>
    <form method="post" action="/mot-de-passe-oublie" class="space-y-5">
      <%- include('../../partials/csrf') %>
      <%- include('../../partials/field', { name: 'email', label: 'Adresse e-mail', type: 'email', required: true, attrs: 'autocomplete="email" autofocus' }) %>
      <button class="btn btn-primary w-full py-2.5">Envoyer le lien</button>
    </form>
  <% } %>
<%- include('_shell-end', { footer: '<a class="font-semibold text-brand-600 hover:text-brand-700" href="/connexion">Retour à la connexion</a>' }) %>

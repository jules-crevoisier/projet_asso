<div class="max-w-md">
  <h1 class="h-page">Se connecter</h1>
  <p class="mt-3 text-ink-2">Pas encore de compte ? <a class="link" href="/inscription">Créer un compte</a></p>

  <% if (error) { %>
    <div class="notice notice-error mt-8" role="alert"><p><strong><%= error %></strong> Vérifiez votre adresse, ou <a class="link" href="/mot-de-passe-oublie">réinitialisez votre mot de passe</a>.</p></div>
  <% } %>

  <form method="post" action="/connexion" class="mt-8 space-y-6">
    <%- include('../../partials/csrf') %>
    <%- include('../../partials/field', { name: 'email', label: 'Adresse e-mail', type: 'email', value: email, required: true, attrs: 'autocomplete="email" autofocus spellcheck="false"' }) %>
    <%- include('../../partials/field', { name: 'password', label: 'Mot de passe', type: 'password', required: true, attrs: 'autocomplete="current-password"' }) %>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <button class="btn btn-primary">Se connecter</button>
      <a href="/mot-de-passe-oublie" class="link shrink-0 whitespace-nowrap text-[15px]">Mot de passe oublié</a>
    </div>
  </form>
</div>

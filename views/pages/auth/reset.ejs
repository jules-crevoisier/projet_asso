<div class="max-w-md">
  <h1 class="h-page">Nouveau mot de passe</h1>
  <% if (!valid) { %>
    <p class="mt-4 text-ink-2">Ce lien a expiré ou a déjà servi.</p>
    <a href="/mot-de-passe-oublie" class="btn btn-primary mt-6">Demander un nouveau lien</a>
  <% } else { %>
    <form method="post" class="mt-8 space-y-6">
      <%- include('../../partials/csrf') %>
      <%- include('../../partials/field', { name: 'password', label: 'Nouveau mot de passe', help: 'Au moins 8 caractères.', type: 'password', error, required: true, attrs: 'autocomplete="new-password" minlength="8" autofocus' }) %>
      <button class="btn btn-primary">Enregistrer le mot de passe</button>
    </form>
  <% } %>
</div>

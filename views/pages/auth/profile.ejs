<%- include('../../partials/page-header', { heading: 'Mon profil', subtitle: `Connecté avec ${user.email}` }) %>

<div class="grid gap-x-16 gap-y-12 lg:grid-cols-[1fr_20rem]">
  <div class="space-y-14">
    <section aria-labelledby="infos">
      <h2 id="infos" class="h-section mb-6">Informations</h2>
      <form method="post" action="/profil" class="max-w-xl space-y-6">
        <%- include('../../partials/csrf') %>
        <div class="grid gap-6 sm:grid-cols-2">
          <%- include('../../partials/field', { name: 'firstName', label: 'Prénom', value: values.firstName, error: errors.firstName, required: true }) %>
          <%- include('../../partials/field', { name: 'lastName', label: 'Nom', value: values.lastName, error: errors.lastName, required: true }) %>
        </div>
        <%- include('../../partials/field', { name: 'phone', label: 'Téléphone', optional: true, help: 'Visible seulement par les organisateurs des événements où vous êtes bénévole.', type: 'tel', value: values.phone, cls: 'max-w-xs', attrs: 'autocomplete="tel"' }) %>
        <%- include('../../partials/field', { name: 'bio', label: 'Présentation', optional: true, type: 'textarea', value: values.bio, rows: 3, help: 'Vos compétences ou disponibilités, par exemple.' }) %>
        <button class="btn btn-primary">Enregistrer</button>
      </form>
    </section>

    <section id="agenda" aria-labelledby="agenda-titre" class="border-t border-line pt-10">
      <h2 id="agenda-titre" class="h-section">Abonner votre agenda</h2>
      <p class="mt-3 max-w-prose text-ink-2">Ajoutez ce lien comme <strong class="text-ink">agenda par URL</strong>. Dans Google Agenda : « Autres agendas », puis « À partir de l'URL ». Les événements des associations s'y affichent et se mettent à jour automatiquement.</p>
      <div class="mt-6 max-w-2xl space-y-5">
        <% [['Tous les événements', feedUrl], ['Seulement ceux de vos associations', `${feedUrl}?mes=1`]].forEach(([label, url], i) => { %>
          <div>
            <label class="label" for="feed-<%= i %>"><%= label %></label>
            <div class="flex gap-2">
              <input id="feed-<%= i %>" class="input font-mono text-[13px]" readonly value="<%= url %>" data-select-on-focus>
              <button type="button" class="btn btn-secondary" data-copy="#feed-<%= i %>"><span>Copier</span></button>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="mt-6 flex max-w-2xl flex-col gap-3 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-[15px] text-ink-2">Ce lien est personnel : il donne accès aux événements réservés aux associations.</p>
        <form method="post" action="/profil/agenda/regenerer" data-confirm="L'ancien lien cessera de fonctionner. Continuer ?">
          <%- include('../../partials/csrf') %><button class="btn btn-secondary btn-sm">Générer un nouveau lien</button>
        </form>
      </div>
    </section>

    <section aria-labelledby="mdp" class="border-t border-line pt-10">
      <h2 id="mdp" class="h-section mb-6">Mot de passe</h2>
      <form method="post" action="/profil/mot-de-passe" class="max-w-xl space-y-6">
        <%- include('../../partials/csrf') %>
        <%- include('../../partials/field', { name: 'currentPassword', label: 'Mot de passe actuel', type: 'password', error: passwordError, required: true, attrs: 'autocomplete="current-password"' }) %>
        <%- include('../../partials/field', { name: 'newPassword', label: 'Nouveau mot de passe', help: 'Au moins 8 caractères.', type: 'password', required: true, attrs: 'autocomplete="new-password" minlength="8"' }) %>
        <button class="btn btn-secondary">Changer le mot de passe</button>
      </form>
    </section>
  </div>

  <aside>
    <h2 class="h-block mb-3 border-b border-ink pb-2">Vos associations</h2>
    <% if (memberships.length) { %>
      <ul class="space-y-1">
        <% memberships.forEach((m) => { %>
          <li class="flex items-center gap-3 py-1.5">
            <span class="swatch size-3" style="background-color: <%= m.color %>"></span>
            <a class="link-quiet min-w-0 flex-1 truncate" href="/associations/<%= m.slug %>"><%= m.name %></a>
            <span class="text-[13px] text-ink-3"><%= m.status === 'pending' ? 'En attente' : (m.role === 'admin' ? 'Responsable' : 'Membre') %></span>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="text-ink-2">Aucune pour l'instant. <a class="link" href="/associations">Parcourir l'annuaire</a></p>
    <% } %>
  </aside>
</div>

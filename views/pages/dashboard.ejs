<div class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
  <div>
    <p class="kicker mb-3"><%= fmt.dayHeading(new Date()) %> · semaine <%= weekNumber %></p>
    <h1 class="h-page">Bonjour <%= user.first_name %></h1>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/annonces/nouvelle" class="btn btn-secondary">Publier une annonce</a>
    <a href="/evenements/nouveau" class="btn btn-primary">Publier une date</a>
  </div>
</div>

<% if (pending.length) { %>
  <section id="demandes" class="mb-12" aria-labelledby="demandes-titre">
    <div class="section-head"><h2 id="demandes-titre" class="h-section"><%= plural(pending.length, 'demande') %> d'adhésion <span class="tag tag-signal ml-1 align-[3px]">À traiter</span></h2></div>
    <ul class="rows border-t border-line">
      <% pending.forEach((m) => { %>
        <li class="flex flex-col gap-3 py-3.5 sm:flex-row sm:items-center">
          <div class="min-w-0 flex-1">
            <p><strong><%= m.first_name %> <%= m.last_name %></strong> veut rejoindre <a class="link" href="/associations/<%= m.slug %>"><%= m.association_name %></a></p>
            <% if (m.message) { %><p class="meta mt-0.5">« <%= m.message %> »</p><% } %>
          </div>
          <div class="flex gap-2">
            <form method="post" action="/associations/<%= m.slug %>/membres/<%= m.id %>/accepter"><%- include('../partials/csrf') %><button class="btn btn-primary btn-sm">Accepter</button></form>
            <form method="post" action="/associations/<%= m.slug %>/membres/<%= m.id %>/retirer"><%- include('../partials/csrf') %><button class="btn btn-secondary btn-sm">Refuser</button></form>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (!myAssociations.length) { %>
  <section class="notice notice-info mb-12 flex-col gap-3 py-5 sm:flex-row sm:items-center">
    <div class="flex-1">
      <p class="font-semibold">Rejoignez votre association pour publier des dates</p>
      <p class="mt-0.5 text-ink-2">Elle est peut-être déjà inscrite. Sinon, créez sa fiche : un modérateur la vérifie.<% if (myPending.length) { %> En attente : <%= myPending.map((m) => m.name).join(', ') %>.<% } %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/associations" class="btn btn-primary">Trouver mon association</a>
      <a href="/associations/nouvelle" class="btn btn-secondary">L'inscrire</a>
    </div>
  </section>
<% } %>

<section class="mb-16" aria-labelledby="semaine">
  <div class="section-head">
    <h2 id="semaine" class="h-section">Planning de la semaine<% if (planning.conflictCount) { %> <span class="text-[15px] font-semibold text-accent">· <%= plural(planning.conflictCount, 'conflit') %></span><% } %></h2>
    <a href="/evenements" class="link shrink-0 whitespace-nowrap text-[15px]">Ouvrir l'agenda</a>
  </div>
  <%- include('../partials/planning', { planning, list: weekList, canCreate: true }) %>
  <% if (!weekEvents) { %><p class="mt-4 text-ink-2">Aucune date cette semaine. <a class="link" href="/evenements/nouveau">Publier la vôtre</a></p><% } %>
</section>

<div class="grid gap-x-14 gap-y-14 lg:grid-cols-[2fr_1fr]">
  <section aria-labelledby="prochains">
    <div class="section-head">
      <h2 id="prochains" class="h-section"><%= myAssociations.length ? 'Prochaines dates de vos associations' : 'Prochainement' %></h2>
      <a href="/evenements/liste<%= myAssociations.length ? '?mes=1' : '' %>" class="link shrink-0 whitespace-nowrap text-[15px]">Tout voir</a>
    </div>
    <% const list = myAssociations.length ? myEvents : upcoming; %>
    <% if (list.length) { %>
      <div class="rows border-t border-line">
        <% list.forEach((e) => { %>
          <div class="group relative grid grid-cols-[7.5rem_1fr] gap-x-4 py-3.5 sm:grid-cols-[11.5rem_1fr]">
            <span class="text-[15px] text-ink-2"><%= fmt.date(e.start_at).replace(/^./, (c) => c.toUpperCase()) %><br><span class="tnum"><%= fmt.hour(e.start_at) %></span></span>
            <div class="flex min-w-0 gap-3">
              <span class="swatch mt-1.5" style="background-color: <%= e.association_color %>"></span>
              <div class="min-w-0">
                <a href="/evenements/<%= e.id %>" class="text-[17px] font-semibold after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-[3px]"><%= e.title %></a>
                <p class="text-[15px] text-ink-2"><%= e.association_name %> · <%= e.location %></p>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="border-t border-line py-5 text-ink-2">Rien de prévu. <a class="link" href="/evenements/nouveau">Publier une date</a></p>
    <% } %>
  </section>

  <aside class="space-y-12">
    <% if (myAssociations.length) { %>
      <section>
        <div class="section-head"><h2 class="h-section">Vos associations</h2></div>
        <ul class="rows border-t border-line">
          <% myAssociations.forEach((a) => { %>
            <li class="flex items-center gap-3 py-3">
              <span class="swatch" style="background-color: <%= a.color %>"></span>
              <a class="link-quiet min-w-0 flex-1 truncate font-medium" href="/associations/<%= a.slug %>"><%= a.name %></a>
              <% if (!a.can_publish) { %><span class="tag tag-warn">En validation</span><% } %>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>
    <% if (volunteering.length) { %>
      <section>
        <div class="section-head"><h2 class="h-section">Vous êtes bénévole</h2></div>
        <ul class="rows border-t border-line">
          <% volunteering.forEach((v) => { %><li class="py-3"><a class="link-quiet font-medium" href="/evenements/<%= v.id %>"><%= v.title %></a><p class="meta"><%= fmt.date(v.start_at) %>, <%= fmt.hour(v.start_at) %></p></li><% }) %>
        </ul>
      </section>
    <% } %>
    <section>
      <div class="section-head"><h2 class="h-section">Annonces</h2><a href="/annonces" class="link shrink-0 whitespace-nowrap text-[15px]">Toutes</a></div>
      <div class="rows border-t border-line">
        <% if (posts.length) { posts.forEach((post) => { %><%- include('../partials/post-row', { post, compact: true }) %><% }) } else { %>
          <p class="py-5 text-ink-2">Aucune annonce. <a class="link" href="/annonces/nouvelle">Demander un coup de main</a></p>
        <% } %>
      </div>
    </section>
  </aside>
</div>

<% if (flash.length) { %>
  <div class="mb-6 space-y-2">
    <% flash.forEach((f) => {
      const styles = {
        success: ['bg-emerald-50 text-emerald-800 ring-emerald-600/15', 'CircleCheck', 'text-emerald-500'],
        error: ['bg-red-50 text-red-800 ring-red-600/15', 'CircleX', 'text-red-500'],
        info: ['bg-brand-50 text-brand-900 ring-brand-600/15', 'Info', 'text-brand-500'],
      }[f.type] || ['bg-slate-50 text-slate-800 ring-slate-600/15', 'Info', 'text-slate-500'];
    %>
      <div class="flex items-start gap-3 rounded-xl px-4 py-3 text-sm ring-1 ring-inset <%= styles[0] %>" data-flash>
        <%- icon(styles[1], `size-5 ${styles[2]}`) %>
        <p class="flex-1 pt-px"><%= f.message %></p>
        <button type="button" class="opacity-50 hover:opacity-100" data-dismiss aria-label="Fermer"><%- icon('X') %></button>
      </div>
    <% }) %>
  </div>
<% } %>

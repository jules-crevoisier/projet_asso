<% if (flash.length) { %>
  <div class="mb-8 space-y-2" role="status">
    <% flash.forEach((f) => { %>
      <div class="notice notice-<%= f.type === 'error' ? 'error' : f.type === 'success' ? 'success' : 'info' %> items-start" data-flash>
        <p class="flex-1"><%= f.message %></p>
        <button type="button" class="-my-1 -mr-2 grid size-8 place-items-center text-ink-3 hover:text-ink" data-dismiss aria-label="Fermer le message"><%- icon('X') %></button>
      </div>
    <% }) %>
  </div>
<% } %>

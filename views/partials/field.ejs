<%
  // Paramètres : name, label, type, value, error, help, placeholder, required, options, rows, attrs, cls, inputCls, optional
  const id = `f-${name}`;
  const t = locals.type || 'text';
  const v = locals.value ?? '';
  const err = locals.error;
  const described = [locals.help ? `${id}-hint` : '', err ? `${id}-error` : ''].filter(Boolean).join(' ');
  const aria = `${described ? `aria-describedby="${described}"` : ''} ${err ? 'aria-invalid="true"' : ''}`;
%>
<div class="<%= locals.cls || '' %>">
  <% if (locals.label) { %><label for="<%= id %>" class="label"><%= label %><% if (locals.optional) { %> <span class="font-normal text-ink-3">(facultatif)</span><% } %></label><% } %>
  <% if (locals.help) { %><span id="<%= id %>-hint" class="hint"><%= help %></span><% } %>
  <% if (err) { %><span id="<%= id %>-error" class="field-error"><%= err %></span><% } %>
  <% if (t === 'textarea') { %>
    <textarea id="<%= id %>" name="<%= name %>" rows="<%= locals.rows || 4 %>" class="input <%= locals.inputCls || '' %> <%= err ? 'input-error' : '' %>" placeholder="<%= locals.placeholder || '' %>" <%= locals.required ? 'required' : '' %> <%- aria %> <%- locals.attrs || '' %>><%= v %></textarea>
  <% } else if (t === 'select') { %>
    <select id="<%= id %>" name="<%= name %>" class="input <%= locals.inputCls || '' %> <%= err ? 'input-error' : '' %>" <%= locals.required ? 'required' : '' %> <%- aria %> <%- locals.attrs || '' %>>
      <% (locals.options || []).forEach(([val, text]) => { %><option value="<%= val %>" <%= String(val) === String(v) ? 'selected' : '' %>><%= text %></option><% }) %>
    </select>
  <% } else { %>
    <input id="<%= id %>" name="<%= name %>" type="<%= t %>" value="<%= v %>" class="input <%= locals.inputCls || '' %> <%= err ? 'input-error' : '' %>" placeholder="<%= locals.placeholder || '' %>" <%= locals.required ? 'required' : '' %> <%- aria %> <%- locals.attrs || '' %>>
  <% } %>
</div>

<%
  // Liste d'événements groupée par jour. Paramètres : events, nested (sous un titre de section)
  const days = groupByDay(events);
%>
<div class="<%= locals.nested ? 'space-y-4' : 'space-y-8' %>">
  <% days.forEach((day) => { %>
    <section aria-labelledby="jour-<%= day.key %>">
      <h3 id="jour-<%= day.key %>" class="flex flex-wrap items-center gap-x-3 gap-y-1 py-3 <%= locals.nested ? 'border-t border-line' : 'border-t-2 border-ink' %>">
        <span class="<%= locals.nested ? 'text-[18px]' : 'text-[22px]' %> font-bold tracking-[-0.02em]"><%= fmt.dayHeading(day.date) %></span>
        <% if (day.conflict) { %><span class="tag tag-signal">Conflit</span><% } %>
      </h3>
      <ol class="rows border-t border-line">
        <% day.events.forEach((event) => { %>
          <li class="group relative grid grid-cols-[6.5rem_1fr] gap-x-4 py-3.5 sm:grid-cols-[8.5rem_1fr]">
            <span class="tnum pt-0.5 text-[15px] text-ink-2"><%= fmt.hourRange(event.start_at, event.end_at) %></span>
            <div class="flex min-w-0 gap-3">
              <span class="swatch mt-1.5" style="background-color: <%= event.association_color %>"></span>
              <div class="min-w-0">
                <a href="/evenements/<%= event.id %>" class="text-[17px] font-semibold leading-snug text-ink after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-[3px]"><%= event.title %></a>
                <% if (event.visibility === 'network') { %><span class="tag ml-1 align-[2px]">Réseau</span><% } %>
                <p class="mt-0.5 text-[15px] text-ink-2"><%= event.association_name %> · <%= event.location %></p>
                <% if (event.volunteers_needed > event.nb_volunteers) { %><p class="mt-1 text-[14px] font-semibold text-accent">Cherche <%= event.volunteers_needed - event.nb_volunteers %> bénévole<%= event.volunteers_needed - event.nb_volunteers > 1 ? 's' : '' %></p><% } %>
              </div>
            </div>
          </li>
        <% }) %>
      </ol>
    </section>
  <% }) %>
</div>

<a href="/evenements/<%= event.id %>" class="group flex items-center gap-4 px-5 py-3.5 transition hover:bg-slate-50/80 sm:px-6">
  <div class="relative w-12 shrink-0 overflow-hidden rounded-xl bg-white text-center ring-1 ring-slate-200">
    <div class="h-1.5" style="background-color: <%= event.association_color %>"></div>
    <div class="pt-1 text-lg font-bold leading-none text-slate-900"><%= fmt.day(event.start_at) %></div>
    <div class="pb-1.5 text-[10px] font-semibold uppercase tracking-wide text-slate-500"><%= fmt.monthShort(event.start_at) %></div>
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span class="truncate font-semibold text-slate-900 group-hover:text-brand-700"><%= event.title %></span>
      <% if (event.visibility === 'network') { %><span class="badge badge-indigo"><%- icon('Lock', 'size-3') %>Réseau</span><% } %>
      <% if (event.volunteers_needed > event.nb_volunteers) { %><span class="badge badge-amber"><%- icon('HandHeart', 'size-3') %>Bénévoles</span><% } %>
    </div>
    <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-sm text-slate-500">
      <span class="inline-flex items-center gap-1"><%- icon('Clock', 'size-3.5') %><%= fmt.time(event.start_at) %></span>
      <span class="inline-flex min-w-0 items-center gap-1"><%- icon('MapPin', 'size-3.5') %><span class="truncate"><%= event.location %></span></span>
      <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full" style="background-color: <%= event.association_color %>"></span><%= event.association_name %></span>
    </div>
  </div>
  <%- icon('ChevronRight', 'size-4 text-slate-300 transition group-hover:translate-x-0.5 group-hover:text-slate-500') %>
</a>

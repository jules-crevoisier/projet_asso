<header class="sticky top-0 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5 text-[15px] font-semibold tracking-tight"><%- include('logo') %><%= platformName %></a>
    <nav class="hidden items-center gap-1 sm:flex">
      <a href="/evenements" class="btn btn-ghost <%= path.startsWith('/evenements') ? 'text-slate-900' : '' %>">Calendrier</a>
      <a href="/associations" class="btn btn-ghost <%= path.startsWith('/associations') ? 'text-slate-900' : '' %>">Associations</a>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a href="/connexion" class="btn btn-ghost">Connexion</a>
      <a href="/inscription" class="btn btn-primary">Créer un compte</a>
    </div>
  </div>
</header>

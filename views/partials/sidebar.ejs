<%
  const links = [
    { href: '/tableau-de-bord', label: 'Tableau de bord', icon: 'LayoutDashboard', match: (p) => p === '/tableau-de-bord' },
    { href: '/evenements', label: 'Calendrier', icon: 'CalendarDays', match: (p) => p === '/evenements' || /^\/evenements\/(\d|nouveau)/.test(p) },
    { href: '/evenements/liste', label: 'Événements', icon: 'List', match: (p) => p.startsWith('/evenements/liste') },
    { href: '/annonces', label: 'Annonces', icon: 'Megaphone', match: (p) => p.startsWith('/annonces') },
    { href: '/associations', label: 'Associations', icon: 'UsersRound', match: (p) => p.startsWith('/associations') && !p.startsWith('/associations/moderation') },
  ];
  const mine = locals.sidebarAssociations || [];
%>
<div class="fixed inset-0 z-40 hidden bg-slate-900/40 backdrop-blur-sm lg:hidden" data-sidebar-backdrop></div>
<aside class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 lg:translate-x-0" data-sidebar>
  <div class="flex h-16 items-center gap-2.5 px-5">
    <a href="/tableau-de-bord" class="flex items-center gap-2.5 text-[15px] font-semibold tracking-tight"><%- include('logo') %><%= platformName %></a>
    <button type="button" class="btn btn-ghost btn-icon ml-auto lg:hidden" data-sidebar-close aria-label="Fermer le menu"><%- icon('X', 'size-5') %></button>
  </div>

  <div class="px-3 pb-2">
    <div class="relative" data-dropdown>
      <button type="button" class="btn btn-primary w-full" data-dropdown-toggle><%- icon('Plus') %> Publier</button>
      <div class="absolute inset-x-0 top-full z-10 mt-1.5 hidden overflow-hidden rounded-xl bg-white p-1 shadow-lg ring-1 ring-slate-900/10" data-dropdown-menu>
        <a href="/evenements/nouveau" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-slate-50"><%- icon('CalendarPlus', 'size-4 text-slate-500') %>Un événement</a>
        <a href="/annonces/nouvelle" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-slate-50"><%- icon('Megaphone', 'size-4 text-slate-500') %>Une annonce</a>
        <a href="/associations/nouvelle" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-slate-50"><%- icon('Building2', 'size-4 text-slate-500') %>Une association</a>
      </div>
    </div>
  </div>

  <nav class="flex-1 space-y-0.5 overflow-y-auto px-3 py-2">
    <% links.forEach((l) => { %>
      <a href="<%= l.href %>" class="nav-link <%= l.match(path) ? 'active' : '' %>"><%- icon(l.icon, 'size-[18px] text-slate-400') %><%= l.label %></a>
    <% }) %>
    <% if (user.is_staff) { %>
      <a href="/associations/moderation" class="nav-link <%= path.startsWith('/associations/moderation') ? 'active' : '' %>">
        <%- icon('ShieldCheck', 'size-[18px] text-slate-400') %>Modération
        <% if (pendingValidation) { %><span class="ml-auto rounded-full bg-amber-100 px-2 text-xs font-semibold text-amber-800"><%= pendingValidation %></span><% } %>
      </a>
    <% } %>
    <% if (pendingRequests) { %>
      <a href="/tableau-de-bord#demandes" class="nav-link"><%- icon('Inbox', 'size-[18px] text-slate-400') %>Demandes<span class="ml-auto rounded-full bg-brand-100 px-2 text-xs font-semibold text-brand-700"><%= pendingRequests %></span></a>
    <% } %>
  </nav>

  <div class="border-t border-slate-100 p-3">
    <div class="relative" data-dropdown>
      <button type="button" class="flex w-full items-center gap-3 rounded-lg p-2 text-left hover:bg-slate-50" data-dropdown-toggle>
        <%- include('avatar', { first: user.first_name, last: user.last_name, size: 'size-9 text-sm' }) %>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold"><%= user.first_name %> <%= user.last_name %></span>
          <span class="block truncate text-xs text-slate-500"><%= user.email %></span>
        </span>
        <%- icon('ChevronDown', 'size-4 text-slate-400') %>
      </button>
      <div class="absolute inset-x-0 bottom-full z-10 mb-1.5 hidden overflow-hidden rounded-xl bg-white p-1 shadow-lg ring-1 ring-slate-900/10" data-dropdown-menu>
        <a href="/profil" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-slate-50"><%- icon('UserRound', 'size-4 text-slate-500') %>Mon profil</a>
        <a href="/profil#agenda" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-slate-50"><%- icon('Rss', 'size-4 text-slate-500') %>Abonnement agenda</a>
        <form method="post" action="/deconnexion">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm text-red-600 hover:bg-red-50"><%- icon('LogOut', 'size-4') %>Déconnexion</button>
        </form>
      </div>
    </div>
  </div>
</aside>

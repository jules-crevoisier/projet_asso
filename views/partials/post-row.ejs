<article class="group relative px-5 py-4">
  <p class="kicker"><%= POST_KINDS[post.kind] || POST_KINDS.other %><% if (post.is_closed) { %> · <span class="text-success">Résolue</span><% } %></p>
  <h3 class="mt-1 font-sans text-[16px] font-bold leading-snug">
    <a href="/annonces/<%= post.id %>" class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-[3px]"><%= post.title %></a>
  </h3>
  <% if (locals.excerpt) { %><p class="mt-1 line-clamp-2 max-w-prose text-[15px] text-ink-2"><%= post.body %></p><% } %>
  <p class="meta mt-1.5 flex flex-wrap items-center gap-x-2">
    <span class="inline-flex items-center gap-1.5"><span class="swatch" style="background-color: <%= post.association_color %>"></span><%= post.association_name %></span>
    <span aria-hidden="true">·</span><span><%= fmt.ago(post.created_at) %></span>
    <% if (post.nb_replies) { %><span aria-hidden="true">·</span><span><%= plural(post.nb_replies, 'réponse') %></span><% } %>
  </p>
</article>

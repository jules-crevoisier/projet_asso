<% const k = POST_KINDS[post.kind] || POST_KINDS.other; %>
<a href="/annonces/<%= post.id %>" class="group flex gap-4 px-5 py-4 transition hover:bg-slate-50/80 sm:px-6">
  <span class="grid size-10 shrink-0 place-items-center rounded-xl badge-<%= k.tone %> ring-1 ring-inset"><%- icon(k.icon, 'size-5') %></span>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-semibold text-slate-900 group-hover:text-brand-700"><%= post.title %></span>
      <% if (post.is_closed) { %><span class="badge badge-slate"><%- icon('Check', 'size-3') %>Résolue</span><% } %>
    </div>
    <% if (locals.excerpt) { %><p class="mt-0.5 line-clamp-2 text-sm text-slate-600"><%= post.body %></p><% } %>
    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-slate-500">
      <span class="font-medium text-slate-600"><%= k.label %></span>
      <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full" style="background-color: <%= post.association_color %>"></span><%= post.association_name %></span>
      <span><%= fmt.ago(post.created_at) %></span>
      <% if (post.nb_replies) { %><span class="inline-flex items-center gap-1"><%- icon('MessageCircle', 'size-3.5') %><%= post.nb_replies %></span><% } %>
    </div>
  </div>
</a>

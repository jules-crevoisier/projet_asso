<span class="<%= locals.size || 'size-8 text-xs' %> inline-grid shrink-0 place-items-center rounded-full font-semibold <%= locals.color ? '' : 'bg-gradient-to-br from-slate-100 to-slate-200 text-slate-600 ring-1 ring-inset ring-slate-900/5' %>"
  <% if (locals.color) { %>style="background-color: <%= color %>; color: <%= contrast(color) %>"<% } %>><%= initials(locals.first || '', locals.last || '') %></span>

<% if (locals.color) { %><span class="<%= locals.size || 'size-9 text-[13px]' %> inline-grid shrink-0 place-items-center rounded-md font-bold text-white" style="background-color: <%= color %>" aria-hidden="true"><%= initials(locals.first || '', locals.last || '') %></span><% } else { %><span class="avatar <%= locals.size || 'size-8' %>" aria-hidden="true"><%= initials(locals.first || '', locals.last || '') %></span><% } %>

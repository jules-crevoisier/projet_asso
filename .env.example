# Copier en .env (ou définir ces variables dans votre hébergeur)
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=assos-troyes.fr,www.assos-troyes.fr
DJANGO_CSRF_TRUSTED_ORIGINS=https://assos-troyes.fr,https://www.assos-troyes.fr
DJANGO_DB_PATH=/data/db.sqlite3

# E-mails (réinitialisation de mot de passe)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.exemple.fr
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=Assos Troyes <noreply@assos-troyes.fr>

PLATFORM_NAME=Assos Troyes
PLATFORM_CITY=Troyes
ASSOCIATIONS_REQUIRE_VALIDATION=True

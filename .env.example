# Copier en .env (local : node --env-file=.env server.js ; Dokploy : onglet « Environment »)

# Obligatoire en production : une longue chaîne aléatoire (ex. `openssl rand -hex 32`)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Adresse publique du site, utilisée dans les e-mails et les flux iCal
BASE_URL=https://assos-troyes.fr

# Compte modérateur créé au premier démarrage s'il n'existe pas encore
ADMIN_EMAIL=vous@exemple.fr
ADMIN_PASSWORD=un-mot-de-passe-solide

PLATFORM_NAME=Assos Troyes
PLATFORM_CITY=Troyes
ASSOCIATIONS_REQUIRE_VALIDATION=true

# E-mails (mot de passe oublié). Sans SMTP, les e-mails s'affichent dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Assos Troyes <noreply@assos-troyes.fr>

# Mettre à false uniquement pour tester en HTTP (http://IP:port) avant d'avoir un domaine en HTTPS
# COOKIE_SECURE=false

# Hors Docker seulement (l'image fixe déjà ces valeurs) :
# NODE_ENV=production
# PORT=3000
# DB_PATH=./data/assos.db
